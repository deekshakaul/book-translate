# Copy this file to .env and fill in your actual values.
# Local Ollama models don't need real API keys (any placeholder works).

# --- Groq (cloud) ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# --- Model names ---
# Groq model IDs change over time as old ones are decommissioned.
# Check current available models at https://console.groq.com/docs/models
GROQ_LLAMA_70B=llama-3.1-70b-versatile
GROQ_MIXTRAL_70B=mixtral-8x7b-32768

# Ollama model tags (must match `ollama pull <tag>` / `ollama list`)
OLLAMA_LLAMA_8B=llama3.1:8b
OLLAMA_NEMO=mistral-nemo:12b
